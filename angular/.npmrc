# Kept, and NOT removable by upgrading ABP: @abp/ng.theme.shared depends on
# @swimlane/ngx-datatable@~22.0.0, whose peer range is @angular/core 18.x||19.x||20.x
# while this workspace is on Angular 21. Strict resolution therefore refuses to install
# it and the host build fails on an unresolved import. Verified 2026-09-02 by removing
# this line with ABP already at 10.5.0. The sibling projects avoid the flag only because
# yarn Classic warns on peer conflicts instead of failing -- same conflict, different tool.
# Revisit when ngx-datatable declares Angular 21 support.
legacy-peer-deps=true
# @dignite/ng.flex-fields(-ckeditor) are aliased in package.json to their @dignite-projects/*
# GitHub Packages names (see the alias comment there) because npmjs.org sync lags behind
# GitHub Packages by some margin, and this repo pins whatever flex-fields version it actually
# needs right now. Reintroduces what #596 removed - acceptable while this repo has no external
# contributors; revisit if that changes. GITHUB_PACKAGES_TOKEN needs the read:packages scope.
@dignite-projects:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_PACKAGES_TOKEN}
//npm.pkg.github.com/:always-auth=true
