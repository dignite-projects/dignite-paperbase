<?xml version="1.0" encoding="utf-8"?>
<!-- Looks like a duplicate of the repository-root NuGet.Config, but host/Dockerfile only COPYs
     host/ into the build image, never the root file - deleting this one breaks the Docker build's
     restore of host/src/Dignite.Vault.Extract.Host.csproj (no config would be found). -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
