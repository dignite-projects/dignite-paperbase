<?xml version="1.0" encoding="utf-8"?>
<!-- Looks like a duplicate of the repository-root NuGet.Config. host/Dockerfile now COPYs the root
     file too (see its comment: each restored project resolves NuGet.Config by walking up from ITS
     OWN directory, not the entry-point project's - without the root file, core/* projects have no
     config in their ancestor chain at all inside the image). This file is still the nearest one for
     host/src/Dignite.Vault.Extract.Host.csproj's own direct package references, and matters for any
     restore invoked directly against a project under host/ outside the Docker build - keep it in
     step with the root file rather than deleting it. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Mirrors the repository-root NuGet.Config. NuGet does NOT merge packageSourceMapping across
         config files - the nearest file's mapping section wins outright - so the flex-fields source and
         its mapping have to be repeated here, or host projects would have no mapping for
         Dignite.Abp.FlexFields.* (which they consume transitively through core) and restore would fail.
         Keep the two files in step. See the root NuGet.Config for why this source exists at all. -->
    <add key="github" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="dignite-projects" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Dignite.Abp.FlexFields.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
