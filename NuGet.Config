<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Dignite.Abp.FlexFields.* packages (org: dignite-projects). The flex-fields module publishes
         PRE-RELEASE versions (e.g. 10.0.0-rc.5) to GitHub Packages only; a STABLE 10.0.0 would go to
         nuget.org instead, at which point the mapping below should move back under nuget.org and this
         source can go dormant.

         RELEASE GATE (#558): Dignite.Vault.Extract.* publishes STABLE to the public nuget.org feed, so
         v3 must NOT ship while its flex-fields dependency resolves only from this authenticated,
         org-scoped source — every external consumer's restore would fail. Shipping field architecture
         v3 is blocked on flex-fields publishing a stable 10.0.0 to nuget.org.

         Reading GitHub Packages requires auth even for public packages: set env var
         GITHUB_PACKAGES_TOKEN to a PAT with the read:packages scope. -->
    <add key="github" value="https://nuget.pkg.github.com/dignite-projects/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <!-- Username is ignored by GitHub Packages when a PAT is used, but must be non-empty.
           Token is read from the GITHUB_PACKAGES_TOKEN env var - a distinct name (NOT GITHUB_TOKEN)
           so it does not override the token the gh CLI uses. Never commit it. -->
      <add key="Username" value="dignite-projects" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Dignite.Abp.FlexFields.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
